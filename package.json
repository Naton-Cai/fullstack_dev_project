{
  "name": "fullstack-dev-project",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www",
    "lint": "eslint . bin/www --max-warnings=0",
    "lint:fix": "eslint . bin/www --fix",
    "test": "jest"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "cookie-parser": "^1.4.7",
    "debug": "^4.4.3",
    "dotenv": "^18.0.10",
    "express": "^5.1.0",
    "express-validator": "^7.3.2",
    "http-errors": "^2.0.0",
    "mongoose": "^9.12.0",
    "morgan": "^1.10.1",
    "pug": "^3.0.3"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "nodemonConfig": {
    "watch": [
      "app.js",
      "bin",
      "routes",
      "views",
      "public"
    ],
    "ext": "js,json,pug,css",
    "env": {
      "NODE_ENV": "development"
    }
  },
  "jest": {
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ]
  }
}

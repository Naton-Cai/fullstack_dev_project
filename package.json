{
  "name": "fullstack-dev-project",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "debug": "^4.4.3",
    "express": "^5.1.0",
    "http-errors": "^2.0.0",
    "morgan": "^1.10.1",
    "pug": "^3.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "nodemonConfig": {
    "watch": [
      "app.js",
      "bin",
      "routes",
      "views",
      "public"
    ],
    "ext": "js,json,pug,css",
    "env": {
      "NODE_ENV": "development"
    }
  }
}

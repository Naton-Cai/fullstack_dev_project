
extends layout

block content

  // Main container for the Mixer page.
  .mixer-container.mt-5

    // Page title and description.
    h1.mb-3 Paint Mixer
    p.text-muted Mix two paint colors to create a new color.

    .row.g-4

      // First paint section.
      .col-md-6
        .card.p-3
          h4 Paint 1
          // Paint name is required.
          .mb-3
            label.form-label(for="paint1Name") Paint Name
            input#paint1Name.form-control(
              type="text"
              name="name"
              value=paint1Name
              placeholder="Enter paint name"
            )
          // Enter the first paint hex value.
          label.form-label(for="paint1Hex") Hex Value
          input#paint1Hex.form-control(
            type="text"
            name="paint1Hex"
            value="#FF0000"
            pattern="#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})"
            maxlength="7"
            required
          )

          // Users can choose a color instead of typing its hex value.
          .mb-3
            label.form-label(for="paint1Picker") Choose Color
            input#paint1Picker.form-control.form-control-color(
              type="color"
              value="#FF0000"
              title="Choose a paint color"
            )

          // Preview the first paint color.
          #paint1Preview.color-preview.mt-3(
            style="background-color: #FF0000;"
          )

          // Display the first paint percentage.
          label.form-label.mt-3(for="paint1Percent") Percentage
          input#paint1Percent.form-control(
            type="number"
            name="paint1Percent"
            min="0"
            max="100"
            value="50"
            required
          )

      // Second paint section.
      .col-md-6
        .card.p-3
          h4 Paint 2
          .mb-3
            label.form-label(for="paint2Name") Paint Name
            input#paint2Name.form-control(
              type="text"
              name="name"
              value=paint2Name
              placeholder="Enter paint name"
            )
          // Enter the second paint hex value.
          label.form-label(for="paint2Hex") Hex Value
          input#paint2Hex.form-control(
            type="text"
            name="paint2Hex"
            value="#0000FF"
            pattern="#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})"
            maxlength="7"
            required
          )

          // Users can choose a color instead of typing its hex value.
          .mb-3
            label.form-label(for="paint2Picker") Choose Color
            input#paint2Picker.form-control.form-control-color(
              type="color"
              value="#0000FF"
              title="Choose a paint color"
            )

          // Preview the second paint color.
          #paint2Preview.color-preview.mt-3(
            style="background-color: #0000FF;"
          )

          // Display the second paint percentage.
          label.form-label.mt-3(for="paint2Percent") Percentage
          input#paint2Percent.form-control(
            type="number"
            name="paint2Percent"
            min="0"
            max="100"
            value="50"
            required
          )

    // Display percentage validation errors.
    #percentageError.text-danger.mt-3

    // Button for mixing the selected colors.
    .text-center.mt-4
      button#mixButton.btn.btn-primary(
        type="button"
      ) Mix Colors

        // Display the mixed paint result.
    form#saveForm.card.p-4.mt-4(action="/paints/add" method="POST")
      h4.text-center Mixed Color Result

      // Hidden fields filled in by mixer.js before submitting.
      each field in ['hexValue', 'paint1Name', 'paint1Hex', 'paint1Percent', 'paint2Name', 'paint2Hex', 'paint2Percent']
        input(type="hidden" name=field)

      // Preview of the mixed color.
      #mixedColorPreview.color-preview.mt-3

      // Display the resulting hex value.
      p#mixedHex.text-center.mt-3 No color mixed yet

      // Name of the new mixed paint.
      label.form-label(for="mixedPaintName") Paint Name
      input#mixedPaintName.form-control(
        type="text"
        name="name"
        placeholder="Enter mixed paint name"
        required
      )
      label.form-label(for="description") Description
      textarea#description.form-control(
        name="description"
        rows="3"
        placeholder="Optional paint description"
      )= description

      // Save and Cancel buttons.
      .d-flex.gap-3.mt-4
        button#saveMixButton.btn.btn-success(type="submit" disabled) Save Paint
        a.btn.btn-secondary(href="/paints") Cancel

        // Connect the frontend JavaScript.
  script(src="/vendor/mixbox/mixbox.js")
  script(src="/javascripts/mixer.js")

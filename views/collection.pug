extends layout

block content
    section.py-4(aria-label='Paint collection')
    
        //- Search and Add Paint
        div.d-flex.gap-3.mb-4
            div.flex-grow-1
                label.visually-hidden(for='paint-search') Search paint
                input#paint-search.form-control.rounded-pill(
                    type='search'
                    placeholder='Search Paint'
                )

            button.btn.btn-outline-dark.text-nowrap(type='button') Add Paint
        
        //- Responsive paint grid
        if paints && paints.length !== 0
            div.row.row-cols-1.row-cols-sm-2.row.row-cols-md-3.g-3
                each paint in paints    
                    div.col 
                        article.card.h-100.border-secondary
                            div.card-body 
                                div.ratio.ratio-4x3.border.border-dark.rounded(
                                    style=`background-color: ${paint.Hex_value};`
                                    role='img'
                                    aria-label=`Color preview for ${paint.Name}`
                                )
                            
                                div.d-flex.justify-content-between.align-items-center.gap-2.mt-3
                                    div
                                        h2.h6.mb-1.fw-bold= paint.Name
                                        p.mb-0.fst-italic Hex: #{paint.Hex_value}

                                    button.btn.btn-outline-danger.btn-sm(
                                        type='button'
                                        aria-label=`Delete ${paint.Name}`
                                    ) Delete
        else
            p.text-center.text-muted.py-5 No paints in your collection yet.